# Required: Gemini API key (API_KEY is used by Docker deliverable; GEMINI_API_KEY is accepted as fallback)
API_KEY=
GEMINI_API_KEY=

# Required: Target Zendesk Help Center URL
ZENDESK_BASE_URL=https://support.example.com
ZENDESK_LOCALE=en-us
MIN_ARTICLES=30
MAX_ARTICLES=

# Gemini File Search Store & Model
GEMINI_FILE_SEARCH_STORE_NAME=support-kb
GEMINI_MODEL=gemini-2.5-flash

# Assistant Persona (override via env for target deployment)
ASSISTANT_NAME=SupportBot
BRAND_NAME=Example.com
SYSTEM_PROMPT=

# Local Paths & Chunking Telemetry
ARTICLES_DIR=data/articles
STATE_FILE=data/state.json
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
LOG_LEVEL=INFO
